# Telegram notifications/buttons
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional Google Workspace integration
# OAuth authorized-user token for the dedicated jobs/agent Gmail account.
# Keep this file outside git.
GOOGLE_TOKEN_PATH=/home/you/.jobhunter/google_token.json

# Shared Google Sheet tracker created by the main/personal Google account and
# shared with the jobs/agent Gmail account as Editor.
JOBHUNTER_TRACKER_SPREADSHEET_ID=your_google_sheet_id_here
JOBHUNTER_TRACKER_TAB=Applications

# Optional local state/config paths. Keep them outside git.
JOBHUNTER_STATE_DIR=/home/you/.jobhunter/state
JOBHUNTER_TRACKER_DRIVE_FOLDER_NAME=JobHunter Application Evidence

# Optional: sync the Google Sheet every time an application stage is recorded.
# The sync is best-effort: failures are logged but do not block applying.
JOBHUNTER_AUTO_SYNC_TRACKER=false
JOBHUNTER_TRACKER_SYNC_COMMAND=/absolute/path/to/jobhunter_sync_application_tracker.sh
JOBHUNTER_TRACKER_SYNC_TIMEOUT=120

# Target monthly salary, in AED, used in Interested research briefs and salary ask guidance.
# Keep configurable per user/profile; example default is only a placeholder.
JOBHUNTER_TARGET_SALARY_AED_MONTHLY=30000

# Optional: best-effort web search enrichment for Interested research briefs.
# If search fails/timeouts, JobHunter falls back to stored metadata and salary heuristics.
JOBHUNTER_INTERESTED_WEB_RESEARCH=true
JOBHUNTER_WEB_RESEARCH_TIMEOUT=8
