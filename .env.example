# Telegram notifications/buttons
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional Google Workspace integration
# OAuth authorized-user token for the dedicated jobs/agent Gmail account.
# Keep this file outside git.
GOOGLE_TOKEN_PATH=/home/you/.jobhunter/google_token.json

# Shared Google Sheet tracker created by the main/personal Google account and
# shared with the jobs/agent Gmail account as Editor.
JOBHUNTER_TRACKER_SPREADSHEET_ID=your_google_sheet_id_here
JOBHUNTER_TRACKER_TAB=Applications

# Optional local state/config paths. Keep them outside git.
JOBHUNTER_STATE_DIR=/home/you/.jobhunter/state
JOBHUNTER_TRACKER_DRIVE_FOLDER_NAME=JobHunter Application Evidence
